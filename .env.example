APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# GridRecall runs in local demo mode until these values are supplied.
# CockroachDB Cloud URL should end with sslmode=verify-full&sslrootcert=system.
DATABASE_URL=
AWS_REGION=us-east-1
# Leave blank for the credential-free local reasoner; production uses us.amazon.nova-lite-v1:0.
BEDROCK_REASONING_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_CLUSTER_ID=
COCKROACH_MCP_API_KEY=

VITE_API_URL=http://localhost:8000
